# Meta Loop — configuration placeholders (DO NOT COMMIT A REAL .env)
# Copy to .env and fill ONLY with environment-specific values.
# Never commit a real PAT, API key, DB password, webhook secret, or local path.

# GitHub (decision: personal fine-grained PAT for MVP; trigger authority: Kai only)
META_LOOP_GITHUB_ORG=<github-org-placeholder>
META_LOOP_GITHUB_REPO=<github-repo-placeholder>
META_LOOP_GITHUB_PAT=<github-fine-grained-pat-placeholder>
META_LOOP_TRIGGER_AUTHOR=Kai
META_LOOP_TRIGGER_LABEL=meta-loop:ready

# PostgreSQL queue / durable ledgers
META_LOOP_POSTGRES_DSN=postgresql://<user>:<password>@<host>:<port>/<db>

# Content-addressed artifact store
META_LOOP_CAS_ROOT=<local-cas-root-placeholder>

# Governance boundary. Production remains fail-closed unless a real governance reader is supplied.
META_LOOP_GOVERNANCE_ROOT=<governance-root-placeholder>
META_LOOP_GOVERNANCE_REVISION=<governance-revision-placeholder>

# Phase 8 local publication / verification allowlist
META_LOOP_REPOSITORY_ROOT=<target-repository-root-placeholder>
META_LOOP_PUBLICATION_WORK_ROOT=<managed-publication-work-root-placeholder>
META_LOOP_VERIFIER_IMAGE=<registry/image>@sha256:<64-hex-digest>
META_LOOP_VERIFIER_ARGV_JSON=["<fixed-command>","<fixed-argument>"]

# Phase 8 GitHub publication/check gate
META_LOOP_GITHUB_BASE_BRANCH=<base-branch-placeholder>
META_LOOP_REQUIRED_CHECKS=<required-check-name>[,<required-check-name>...]
# Fail-closed default. Set to 1 only when intentional GitHub writes are authorized.
META_LOOP_GITHUB_WRITE_ENABLED=0
